# B-Ceylon Next — environment template
# Copy to .env and fill in. Everything is OPTIONAL: with no values the app
# runs in demo mode (bookings stored on-device, sandbox card gateway).

# Google Apps Script Web app URL (ends in /exec). Enables live seat counts,
# server-side booking + cancellation. See CONNECT notes in SECURITY.md.
VITE_SHEET_API=https://script.google.com/macros/s/AKfycbx4sjtizA3vngzIlnsivFtBuC6bogF1uIWrtkKqtj3kQ-dbSA8JDWUD5PY9oePmev1L/exec

# Shared secret between this site and Code.gs. NEVER a URL. Rotate often.
VITE_SHEET_KEY=https://script.google.com/macros/s/AKfycbx4sjtizA3vngzIlnsivFtBuC6bogF1uIWrtkKqtj3kQ-dbSA8JDWUD5PY9oePmev1L/exec

# PayHere (LKR). Public merchant id only — the secret stays in Code.gs.
VITE_PAYHERE_MERCHANT_ID=

# Apps Script doPost URL that computes the PayHere hash (see PAYMENTS.md).
VITE_PAYHERE_HASH_ENDPOINT=

# Stripe publishable key (pk_…). sk_… never belongs in the browser.
VITE_STRIPE_PK=
